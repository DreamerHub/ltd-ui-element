{
  "name": "ltd-ui-element",
  "version": "1.0.0",
  "private": true,
  "description": "LTD UI - A Vue 3 component library with original components and Element Plus wrappers",
  "scripts": {
    "dev": "pnpm -F ltd-ui-docs dev",
    "docs:build": "pnpm -F ltd-ui-docs build",
    "docs:preview": "pnpm -F ltd-ui-docs preview",
    "build": "pnpm -r --filter='./packages/**' run build",
    "build:components": "pnpm -r --filter='./packages/components/*' run build",
    "build:wrappers": "pnpm -r --filter='./packages/element-wrappers/*' run build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .eslintignore",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --ignore-path .eslintignore",
    "format": "prettier --write \"**/*.{js,vue,jsx,cjs,mjs,scss,css,md,json}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,vue,jsx,cjs,mjs,scss,css,md,json}\" --ignore-path .prettierignore",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules",
    "bootstrap": "pnpm install",
    "prepare": "husky install",
    "commit": "cz"
  },
  "lint-staged": {
    "*.{js,vue,jsx,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,md,json}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "keywords": [
    "vue3",
    "vue",
    "component",
    "ui",
    "element-plus",
    "ltd-ui"
  ],
  "author": "LTD Team",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-vue": "^9.22.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "sass": "^1.71.0",
    "vite": "^5.1.0",
    "vitest": "^1.3.0",
    "@vitest/coverage-v8": "^1.3.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^24.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
